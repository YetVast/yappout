# =============================================================================
# YappOut V1 Environment Configuration (.env.example)
# =============================================================================
# YappOut is completely free and client-side by default.
# Authentication is OPTIONAL and connects through central Yet Vast Auth.
# All variables below are server-only. NEVER prefix credentials with NEXT_PUBLIC_.

# --- CI/CD & Build-Time Dependency Installation (GitHub Packages) ---
# Required ONLY in CI/CD environments (e.g. Vercel) during "npm ci" / "npm install"
# to download private @yetvast/* packages from https://npm.pkg.github.com via root .npmrc.
# Must be configured in Vercel Project Settings -> Environment Variables.
# Value: GitHub Classic Personal Access Token with scopes: "read:packages", "repo".
# Invariant: Must be named NODE_AUTH_TOKEN (do NOT name it NPM_TOKEN).
# Never commit raw credentials.
NODE_AUTH_TOKEN=

# --- Consuming Application (YappOut) Configuration ---
# Canonical origin for YappOut (defaults to http://localhost:3000 in dev/test).
# Production MUST be set to https://yappout.yetvast.com (matching the approved Yet Vast Auth
# registration redirect URI). Do NOT set to default Vercel deployment domains (*.vercel.app).
YAPPOUT_ORIGIN=http://localhost:3000

# Registered Application ID in central Yet Vast Auth registry
YAPPOUT_APP_ID=yappout

# Optional client secret (only if registered as a confidential OAuth client;
# public clients use PKCE S256 with no static client secret)
YAPPOUT_CLIENT_SECRET=

# --- Central Yet Vast Auth Authority Configuration ---
# Authority origin (verifies assertions via /.well-known/jwks.json; no shared signing secret)
# Production: https://auth.yetvast.com
YETVAST_AUTH_ORIGIN=https://auth.yetvast.com

# Expected token issuer (defaults to YETVAST_AUTH_ORIGIN if omitted)
YETVAST_AUTH_ISSUER=https://auth.yetvast.com

# Remote JWKS endpoint URL (defaults to ${YETVAST_AUTH_ORIGIN}/.well-known/jwks.json)
YETVAST_AUTH_JWKS_URL=https://auth.yetvast.com/.well-known/jwks.json

# --- Development / Test Flags ---
# Set to 1 only during automated tests/local mocks without network connectivity.
# Strictly forbidden in production.
YETVAST_ALLOW_TEST_MODE=0
